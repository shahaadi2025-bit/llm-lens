# ---- LLM Lens configuration (copy to .env; never commit .env) ----
APP_ENV=development            # development | production
PUBLIC_DEMO_MODE=false         # true = restricted public mode (limits enforced from Phase 6)
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# Database (PostgreSQL is primary; SQLite allowed for dev only)
POSTGRES_USER=lens
POSTGRES_PASSWORD=change-me
POSTGRES_DB=lens
DATABASE_URL=postgresql+asyncpg://lens:change-me@db:5432/lens
# DATABASE_URL=sqlite+aiosqlite:///./lens-dev.sqlite

# Model provider: mock | local | ollama | openai_compatible
MODEL_PROVIDER=mock
MODEL_NAME=mock-deterministic-v1
DEVICE=auto                    # auto | cpu | cuda
# OLLAMA_BASE_URL=http://host.docker.internal:11434
# OPENAI_COMPAT_BASE_URL=
# OPENAI_COMPAT_API_KEY=       # optional adapter only; core app never needs it

# CORS: comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost,http://localhost:5173

# ---- Public hosting (see docs/DEPLOYMENT.md) ----
# DATABASE_URL: paste Neon's connection string as-is (postgresql://...?sslmode=require); it is converted automatically.
# FRONTEND_DIST=               # set by the single-container Dockerfile; leave empty for local dev
# PUBLIC_RATE_LIMIT_PER_MINUTE=20
# PUBLIC_MAX_TOTAL_EXPERIMENTS=300

# ---- Accounts and public-mode limits (Phase 6) ----
# SECRET_KEY must be >= 32 random characters in production (the app refuses to start otherwise).
# ALLOW_REGISTRATION=true
# ALLOW_ANONYMOUS_WRITES=true       # false = only signed-in users may create/run experiments
# AUTH_RATE_LIMIT_PER_MINUTE=10     # login/register attempts per IP
# PUBLIC_MAX_USERS=200
# PUBLIC_MAX_EXPERIMENTS_PER_USER=30
# PUBLIC_MAX_CONCURRENT_EXPERIMENTS=2

# ---- CLI ----
# LLM_LENS_API=http://localhost:8000   # server the `llm-lens` command talks to (unless --local)
# LLM_LENS_TOKEN=                      # or run `llm-lens login`
